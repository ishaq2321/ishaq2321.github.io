# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference material (never commit personal photos)
/temp/
portrait-preview/

# keys for the encrypted personal files (see README, "The offer letter")
*.key

# The hero photograph. A personal image, kept out of the repository and its history on
# purpose: scripts/prepare-portrait.py writes it from a local photo, and the deploy
# injects it from a repository secret. Committing it would publish it permanently,
# including in the GitHub history.
/public/portrait.webp

# The curriculum vitae: generated from portfolio.config.json by scripts/generate-resume.mjs
# on every build, and deliberately not committed. It carries an address and a phone
# number, and every time it was regenerated and committed the whole document went back
# into history -- which is how a personal mailbox ended up in seven old revisions of it.
# Generating it in the deploy keeps the published copy and the repository separate.
/public/resume.pdf

# A personal document, same treatment for the same reason: it stays served on the site
# (the Tsinghua chip links to it) but is injected from a repository secret rather than
# committed, so it is not in the repository or its history.
/public/tsinghua-offer.pdf

# Evidence written by scripts/check-palette.mjs: the rendered hero in each colour-scheme
# state, kept for a human to look at when the guard fails. Regenerated on every run.
/palette-guard/
