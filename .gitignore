# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference material (never commit personal photos)
/temp/
portrait-preview/

# keys for the encrypted personal files (see README, "The offer letter")
*.key

# The hero photograph and its cutout layer. Both are personal images and are kept out
# of the repository and its history on purpose: scripts/prepare-portrait.py writes them
# from a local photo, and the deploy injects them from repository secrets. Committing
# either one would publish it permanently, including in the GitHub history.
/public/portrait.webp
/public/portrait-head.webp

# A personal document, same treatment for the same reason: it stays served on the site
# (the Tsinghua chip links to it) but is injected from a repository secret rather than
# committed, so it is not in the repository or its history.
/public/tsinghua-offer.pdf
